  "properties": {
      "insideorroom": {
        "type": "string",
        "description": "判断活动发生在室内还是室外"
      },
      "activity_label": {
        "type": "string",
        "description": "从提供的列表中选择的最匹配的活动标签。",
        "enum": ["画画", "手工", "过家家", "运动"]
