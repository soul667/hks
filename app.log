  "type": "object",
  "title": "儿童活动分析结果",
  "properties": {
      "insideorroom": {
        "type": "string",
        "description": "判断活动发生在室内还是室外"
      },
      "activity_label": {
        "type": "string",
        "description": "从提供的列表中选择的最匹配的活动标签。",
        "enum": ["画画", "手工", "过家家", "运动"]
      },
      "content_description": {
        "type": "string",
        "description": "对视频中观察到的儿童活动和关键物体的客观描述（已忽略贴纸等非真实元素）。"
      },
      "reason": {
