   "$schema": "[http://json-schema.org/draft-07/schema#](http://json-schema.org/draft-07/schema#)",
   "type": "object",
   "title": "儿童活动分析结果",
   "properties": {
     "activity_label": {
       "type": "string",
       "description": "从提供的列表中选择的最匹配的活动标签。",
       "enum": ["画画", "手工", "过家家", "运动"]
     },
     "content_description": {
       "type": "string",
       "description": "对视频中观察到的儿童活动和关键物体的客观描述（已忽略贴纸等非真实元素）。"
     },
     "reason": {
       "type": "string",
       "description": "结合“核心判定标准”、“补充说明”及“音频转录”内容，详细解释为什么选择该活动标签。"
     },
     "audio_transcription": {
       "type": "string",
       "description": "音频转录的原始文本。"
     }
   },
   "required": [
     "activity_label",
     "content_description",
     "reason",
     "audio_transcription"
   ]
 }
 ```

