       "type": "string",
       "description": "对视频中观察到的儿童活动和关键物体的客观描述。"
     },
     "reason": {
       "type": "string",
       "description": "结合“核心判定标准”和“补充说明”，详细解释为什么选择该活动标签。"
     }
   },
   "required": [
     "activity_label",
     "content_description",
     "reason"
   ]
 }

